# Required. The API throws on startup when either value is missing.
# SUPABASE_KEY is the service-role key. Keep it on the server only.
SUPABASE_URL=
SUPABASE_KEY=

# Optional. Defaults to 3000 when unset.
PORT=

# Read by POST /api/razorpay/order. That route returns an error when either is missing.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
